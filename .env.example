EXPO_PUBLIC_API_URL=

# Client ID de tipo "Web application" creado en Google Cloud Console
# (el mismo que usan identify-service y web-client para el login con
# Google). Se usa desde Expo Go, ya que app.json todavia no tiene
# bundleIdentifier/package nativos configurados.
# Si mas adelante se hace un build nativo (EAS build / expo prebuild) con
# bundle id propio, van a sumarse los Client IDs nativos:
#   EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
#   EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
