{
  "expo": {
    "name": "Discordia",
    "slug": "app-mobile",
    "scheme": "discordia",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#072B40",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.g1discordia.appmobile",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Discordia usa el micrófono para que te escuchen en los canales de voz."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Discordia usa la cámara para que te vean en los canales de voz."
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-asset",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "media",
            "enableScreenShareService": true
          }
        }
      ],
      "@config-plugins/react-native-webrtc",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class livekit.org.webrtc.** { *; }\n-keep class livekit.org.jni_zero.** { *; }\n-dontwarn livekit.org.jni_zero.**\n-keep class com.oney.WebRTCModule.** { *; }\n-keep class com.livekit.reactnative.** { *; }"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "527de20a-3bfc-4961-82ec-39312984d118"
      }
    },
    "owner": "g1-discordias-team"
  }
}
